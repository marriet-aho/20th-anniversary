  "supportedHosts": ["SharePointWebPart", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "supportsFullBleed": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70",
    "group": { "default": "Fidelity Bank 20th Anniversary" },
    "title": { "default": "Anniversary Portal" },
    "description": { "default": "20th Anniversary celebration portal" },
    "officeFabricIconFontName": "Page",
    "properties": {
      "description": "20 Years of Audacious Steps"
    }
  }]
}
